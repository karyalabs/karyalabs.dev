---
// A project's screenshot, light or dark with the system, at 640, 960 or 1200 px.
// `priority` for the one that is the page's largest paint: loaded first,
// never lazily.
interface Props { slug: string; name: string; sizes: string; priority?: boolean }
const { slug, name, sizes, priority = false } = Astro.props
const set = (theme: string) => `/shots/${slug}-${theme}-640.webp 640w, /shots/${slug}-${theme}-960.webp 960w, /shots/${slug}-${theme}.webp 1200w`
---
<figure class="shot">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset={set("dark")} sizes={sizes}>
    <img
      src={`/shots/${slug}-light.webp`}
      srcset={set("light")}
      sizes={sizes}
      width="1200"
      height="800"
      alt={`A screenshot of ${name}`}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    >
  </picture>
</figure>
